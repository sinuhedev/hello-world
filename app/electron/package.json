{
  "name": "electron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/electron/index.js",
  "build": {
    "electronLanguages": "en-US",
    "directories": {
      "output": "out"
    },
    "linux": {
      "target": "AppImage"
    },
    "asar": true,
    "files": [
      "src"
    ]
  },
  "scripts": {
    "dev": "DEV=true electron --inspect .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  }
}
