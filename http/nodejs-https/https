const mimeTypes = {
  html: 'text/html',
  css: 'text/css',
  js: 'text/javascript',
  json: 'application/json',
  jpeg: 'image/jpeg',
  jpg: 'image/jpeg',
  png: 'image/png',
  gif: 'image/gif',
  webp: 'image/webp',
  svg: 'image/svg+xml',
  icon: 'image/x-icon',
  webm: 'video/webm',
  ogg: 'video/ogg',
  mp4: 'video/mp4',
  mp3: 'audio/mpeg',
  ttf: 'font/ttf',
  otf: 'font/otf',
  woff: 'font/woff',
  woff2: 'font/woff2',
  pdf: 'application/pdf',
  wasm: 'application/wasm'
}

const CURRENT_PATH = process.argv[2] ?? process.cwd()
const HOSTNAME = '0.0.0.0'
const PORT = 3000

const getMimeType = (filePath) => {
  const ext = path.extname(filePath).slice(1)
  return mimeTypes[ext] ?? 'application/octet-stream'
}

const getLocalIP = () => {
  const interfaces = os.networkInterfaces()
  for (const name of Object.keys(interfaces)) {
    for (const iface of interfaces[name]) {
      // IPv4 y no interna (no 127.0.0.1)
      if (iface.family === 'IPv4' && !iface.internal) {
        return iface.address
      }
    }
  }
  return '127.0.0.1'
}

const serveFile = (res, filePath) => {
  res.writeHead(200, { 'Content-Type': getMimeType(filePath) })
  fs.createReadStream(filePath).pipe(res)
}

const serveDirectory = (res, pathName, uri) => {
  const indexPath = path.join(pathName, 'index.html')
  fs.lstatSync(indexPath)

  return serveFile(res, indexPath)
}

const server = (req, res) => {
  const uri = new URL(req.url, `https://${req.headers.host}`).pathname
  const decodedUri = decodeURIComponent(uri)
  const pathName = path.join(CURRENT_PATH, decodedUri)

  console.log(`Loading ${decodedUri}`)

  try {
    const stats = fs.lstatSync(pathName)

    if (stats.isFile()) serveFile(res, pathName)
    else if (stats.isDirectory()) serveDirectory(res, pathName, decodedUri)
  } catch {
    res.writeHead(404, { 'Content-Type': 'text/plain' })
    res.end('404 : Not Found')
  }
}

https.createServer({key, cert}, server).listen(PORT, HOSTNAME, () => {
  const localIP = getLocalIP()
  console.log(`Server running at:`)
  console.log(`  → Local:   https://localhost:${PORT}`)
  console.log(`  → Network: https://${localIP}:${PORT}`)
})